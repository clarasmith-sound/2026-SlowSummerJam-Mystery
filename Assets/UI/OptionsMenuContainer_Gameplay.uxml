<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StyleSheets/PorkPieFiles_OptionsStyling.uss?fileID=7433441132597879392&amp;guid=4ad5464b4388cf34cb1a272024f77390&amp;type=3#PorkPieFiles_OptionsStyling"/>
    <ui:VisualElement name="OptionsMenuContainer" style="position: absolute; top: -1px; width: 100%; height: 100%; align-items: center; justify-content: center; display: flex; left: 0; right: 0; bottom: 2px;">
        <ui:VisualElement name="ClipboardBackgound" style="background-image: url(&quot;project://database/Assets/Art/UI.png?fileID=667777397&amp;guid=f2da59040992cc84a88abc4e996a4eda&amp;type=3#UI_4&quot;); -unity-background-scale-mode: stretch-to-fill; aspect-ratio: auto; width: 663px; height: 714px; margin-bottom: 0; -unity-slice-type: tiled;">
            <ui:VisualElement name="ClipboardPaper" style="background-image: url(&quot;project://database/Assets/Art/UI.png?fileID=1946861&amp;guid=f2da59040992cc84a88abc4e996a4eda&amp;type=3#UI_13&quot;); width: 87%; height: 91%; left: 50%; top: 3%; translate: -50% 0%;">
                <ui:Label text="Options" style="font-size: 40px; -unity-text-align: middle-center; -unity-font-style: bold; margin-top: 50px; margin-bottom: 65px;"/>
                <ui:VisualElement name="MenuContent">
                    <ui:VisualElement name="SliderMain" class="custom-slider-row">
                        <ui:Label text="Main" name="ChannelLabel" class="channel-label"/>
                        <ui:Slider low-value="-60" class="custom-slider"/>
                        <ui:Label text="0 dB" name="db-value" class="db-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SliderMusic" class="custom-slider-row">
                        <ui:Label text="Music" name="ChannelLabel" class="channel-label"/>
                        <ui:Slider low-value="-60" class="custom-slider"/>
                        <ui:Label text="0 dB" name="db-value" class="db-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SliderSFX" class="custom-slider-row">
                        <ui:Label text="SFX" name="ChannelLabel" class="channel-label"/>
                        <ui:Slider low-value="-60" class="custom-slider"/>
                        <ui:Label text="0 dB" name="db-value" class="db-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SliderAmbience" class="custom-slider-row">
                        <ui:Label text="Ambience" name="ChannelLabel" class="channel-label"/>
                        <ui:Slider low-value="-60" class="custom-slider"/>
                        <ui:Label text="0 dB" name="db-value" class="db-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="SliderDialogue" class="custom-slider-row">
                        <ui:Label text="Dialogue" name="ChannelLabel" class="channel-label"/>
                        <ui:Slider low-value="-60" class="custom-slider"/>
                        <ui:Label text="0 dB" name="db-value" class="db-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Buttons" class="btn-container" style="flex-grow: 1;">
                        <ui:Button text="Resume" name="BackToGame" class="options-btn" style="background-image: url(&quot;project://database/Assets/Art/UI.png?fileID=530779322&amp;guid=f2da59040992cc84a88abc4e996a4eda&amp;type=3#UI_11&quot;); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 24px; padding-left: 16px; padding-bottom: 24px; padding-right: 16px; margin-top: 30px; margin-bottom: 30px; background-size: 100% 50%; width: 130px; height: 97px; font-size: 20px; align-self: center;"/>
                        <ui:Button text="Main Menu" name="BackToStart" class="options-btn" style="background-image: url(&quot;project://database/Assets/Art/UI.png?fileID=530779322&amp;guid=f2da59040992cc84a88abc4e996a4eda&amp;type=3#UI_11&quot;); -unity-background-scale-mode: stretch-to-fill; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; padding-top: 24px; padding-left: 16px; padding-bottom: 24px; padding-right: 16px; margin-top: 30px; margin-bottom: 30px; background-size: 100% 50%; width: 130px; height: 97px; font-size: 20px; align-self: center;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="ClipboardClip" style="background-image: url(&quot;project://database/Assets/Art/UI.png?fileID=450507457&amp;guid=f2da59040992cc84a88abc4e996a4eda&amp;type=3#UI_3&quot;); -unity-background-scale-mode: scale-to-fit; width: 33%; aspect-ratio: 2.228346; left: 50%; translate: -50% -50%; position: absolute;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
