<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="PermanentRecordClue" src="project://database/Assets/UI/PermanentRecordClue.uxml?fileID=9197481963319205126&amp;guid=f3263413286036849bbe66b559f689b2&amp;type=3#PermanentRecordClue"/>
    <Style src="project://database/Assets/UI/Inspection.uss?fileID=7433441132597879392&amp;guid=c0e559634da683c4a8ae3cc6e5d3e851&amp;type=3#Inspection"/>
    <ui:VisualElement name="PermanentRecord" data-source-type="SuspectSO, Assembly-CSharp" class="hidden" style="position: absolute; top: 10%; bottom: 10%; height: 80%; width: 30%; right: 0%; background-color: rgb(255, 255, 255); transition-duration: 0.2s; transition-property: translate; padding-top: 20px; padding-right: 40px; padding-bottom: 20px; padding-left: 40px;">
        <ui:Label text="Permanent Record:" name="TItle" style="font-size: 48px; -unity-text-align: upper-center; margin-top: 26px; -unity-font-style: bold;"/>
        <ui:Label text="maggie" name="Name" style="font-size: 48px; -unity-text-align: upper-center; margin-top: 4px; -unity-font-style: bold;">
            <Bindings>
                <ui:DataBinding property="text" data-source-path="suspectName" binding-mode="ToTarget"/>
            </Bindings>
        </ui:Label>
        <ui:VisualElement name="Clues" style="flex-grow: 1;">
            <ui:Instance template="PermanentRecordClue" name="PermanentRecordClue"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Button text="Back to Default View" name="ExitInspection" style="position: absolute; right: 10px; bottom: 10px; margin-bottom: 8px; margin-top: 8px; margin-right: 8px; margin-left: 8px; display: none; font-size: 24px;"/>
</ui:UXML>
