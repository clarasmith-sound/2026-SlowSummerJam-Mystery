.unity-text-element {
    -unity-font-definition: url("project://database/Assets/UI/Typeface/NotoSerif-VariableFont_wdth,wght.ttf?fileID=12800000&guid=625150be64b3a1549a64af9158f5273f&type=3#NotoSerif-VariableFont_wdth,wght");
    font-size: 8px;
}

#PermanentRecord.hidden {
    translate: 658px 0;
}

.header-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    height: auto;
    flex-grow: 0;
    flex-shrink: 0;
    margin-bottom: 16px;
    align-self: center;
}

#SchoolEmblem {
    width: 128px;
    height: 128px;
    min-height: 128px;
    max-height: 128px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 0;
    flex-shrink: 0;
}

#AcademyTitle {
    font-size: 32px;
    -unity-font-style: bold-and-italic;
    color: rgb(0, 0, 0);
    margin: 0;
    padding: 0;
}

#DocumentSubheader {
    font-size: 18px;
    -unity-font-style: italic;
    color: rgb(60, 60, 60);
    margin-top: 4px;
    margin-bottom: 0;
    padding: 0;
}

.header-text-group {
    flex-direction: column;
    align-items: center;
    flex-grow: 1;
    height: auto;
    margin: 0;
    padding: 0;
    padding-left: 0;
    margin-left: 0;
    margin-right: 20px;
}

.title-block-row {
    width: 100%;
    margin-bottom: 10px;
    height: auto;
    flex-grow: 0;
    background-color: rgba(0, 0, 0, 0);
    align-content: center;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 25px;
    padding-right: 25px;
    min-height: 52px;
    -unity-slice-scale: 1px;
}

#StudentTitle {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

#Name {
    font-size: 24px;
    color: rgb(255, 255, 255);
}

#Clues {
    padding-left: 20px;
}

.options-btn {
    -unity-background-image-tint-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.options-btn:hover {
    -unity-background-image-tint-color: rgb(203, 66, 155);
    color: rgb(255, 255, 255);
}
