<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Overlay" data-source-type="CaseSO, Assembly-CSharp" style="width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.706); justify-content: center; align-items: center; display: none;">
        <ui:VisualElement name="Container" style="position: absolute; top: 0; width: 100%; height: 100%; align-items: center; justify-content: center;">
            <ui:VisualElement name="Modal" style="width: 50%; height: 50%; background-color: rgb(255, 255, 255); align-items: center; padding-top: 40px; padding-right: 40px; padding-bottom: 40px; padding-left: 40px;">
                <ui:Label text="Label" name="CaseName" style="font-size: 45px; -unity-font-style: bold;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="caseName" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="Label" name="CaseDescription" style="font-size: 24px; flex-grow: 1; width: 100%; white-space: normal;">
                    <Bindings>
                        <ui:DataBinding property="text" data-source-path="caseDescription" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Button text="Start Case" name="StartCase"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
